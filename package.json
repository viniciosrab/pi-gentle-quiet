	"type": "module",
	"keywords": [
		"pi-package",
		"pi",
		"pi-coding-agent",
		"gentle-pi",
		"gentle-engram",
		"tui",
		"minimal"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/viniciosrab/pi-gentle-quiet.git"
	},
	"files": [
		"extensions/",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./extensions"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"scripts": {
		"test": "node --experimental-strip-types --import ./test/register.mjs --test \"test/*.test.mjs\""
